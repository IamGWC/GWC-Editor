<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.TextFlow?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.iamgwc.gwcext.ui.EditorController"
            styleClass="root-pane">

    <top>
        <HBox styleClass="toolbar" spacing="6">
            <Label text="GWC" styleClass="brand-mark"/>
            <Region styleClass="toolbar-divider" minWidth="1" maxWidth="1"/>
            <Button fx:id="newButton" text="New" onAction="#onNew" styleClass="toolbar-button"/>
            <Button fx:id="openButton" text="Open" onAction="#onOpen" styleClass="toolbar-button"/>
            <Button fx:id="saveButton" text="Save" onAction="#onSave" styleClass="toolbar-button"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusLabel" styleClass="status-pill"/>
            <Button onAction="#onOpenSettings" styleClass="toolbar-button" text="&#x2699;">
                <tooltip><Tooltip text="Settings"/></tooltip>
            </Button>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.77" styleClass="main-split">
            <StackPane fx:id="editorHost" styleClass="editor-host"/>

            <SplitPane orientation="VERTICAL" dividerPositions="0.56" styleClass="history-split">
                <VBox styleClass="history-panel" spacing="8">
                    <Label text="History" styleClass="panel-title"/>
                    <Label text="Select an entry to inspect" styleClass="panel-subtitle"/>
                    <HBox spacing="6">
                        <TextField fx:id="searchField" promptText="Search history..." styleClass="history-search" HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="typeFilter" styleClass="history-filter"/>
                    </HBox>
                    <ListView fx:id="historyList" VBox.vgrow="ALWAYS" styleClass="history-list"/>
                </VBox>

                <VBox styleClass="detail-panel" spacing="8">
                    <Label text="Detail" styleClass="panel-title"/>
                    <ScrollPane fx:id="detailScroll" fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="detail-scroll">
                        <TextFlow fx:id="detailFlow" styleClass="detail-flow"/>
                    </ScrollPane>
                </VBox>
            </SplitPane>
        </SplitPane>
    </center>

</BorderPane>